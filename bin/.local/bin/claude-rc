#!/usr/bin/env bash
# Keep Claude Remote Control running in tmux, and bring it back after a reauth or reboot.
#
#   claude-rc                     list servers and conversations, and whether they're up
#   claude-rc ls --json           the same as JSON (for dashboards)
#   claude-rc restart             restart servers and conversations whose claude exited;
#                                 --login logs in first (after "log out of all devices")
#   claude-rc restart NAME ...    restart these, even if running
#   claude-rc up                  start everything in the list that isn't running (after a reboot)
#   claude-rc add NAME [DIR] --server     run a `claude remote-control` server in DIR
#   claude-rc add NAME [DIR]              start a new conversation with Remote Control on
#   claude-rc add NAME [DIR] --resume ID  ... or continue an existing one (by its local id)
#   claude-rc rm NAME             stop it and forget it
#   claude-rc save                write the list from the windows running now
#   claude-rc install             keep it all running: start at boot, restart what crashes
#                                 (systemd user timer, or a launchd agent on macOS)
#   claude-rc uninstall           stop doing that
#   claude-rc log                 what the background runs did
#   claude-rc watch               one background run: `up`, then `restart` (what install runs)
#
# Servers: sessions you start from the app run inside the server. A server restarted in the
# same folder rejoins the same Remote Control environment, so those sessions come back too:
# each one restarts the next time it gets a message. A restart right after a crash can
# fail with "already served" for a minute; the next background run tries again.
#
# Conversations: a restart resumes the one the window is on now, even after /clear or
# /resume (from `claude agents --json`), and checks it came back; if the first restart
# fails the rest are left alone. A window whose claude is still running is never restarted
# unless you name it: a session that only lives in Remote Control (no local transcript)
# can't be resumed once it's gone. If one shows "disconnected", run /remote-control in it.
#
# Only the tmux session $CLAUDE_RC_SESSION (default rc) is touched; claude in other tmux
# sessions is listed but left alone. The list (NAME ID|server DIR per line) is in
# ~/.config/claude-rc/sessions, private to you.
# $CLAUDE_RC_FLAGS: conversation flags (default --permission-mode auto --remote-control).
# $CLAUDE_RC_SERVER_FLAGS: server flags (default --permission-mode auto, for the sessions it spawns).

umask 077
session=${CLAUDE_RC_SESSION:-rc}
flags=${CLAUDE_RC_FLAGS:---permission-mode auto --remote-control}
server_flags=${CLAUDE_RC_SERVER_FLAGS:---permission-mode auto}
list=${XDG_CONFIG_HOME:-$HOME/.config}/claude-rc/sessions

# Extra tmux args, for testing on a private server: CLAUDE_RC_TMUX="-L test"
t() { tmux $CLAUDE_RC_TMUX "$@"; }
die() { echo "claude-rc: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

have tmux || die "tmux isn't installed"

valid_name() { case $1 in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac; }
uuid_re='[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}'
valid_uuid() { printf '%s\n' "$1" | grep -qE "^$uuid_re\$"; }

has_session() { t has-session -t "=$session" 2>/dev/null; }
windows() { has_session && t list-windows -t "=$session" -F '#{window_name}'; }
has_window() { windows | grep -qxF -- "$1"; }
# A window's tmux id (@N), so names are never parsed as targets ("a.b" would mean window
# a, pane b). A window that doesn't exist gets a target that can't match anything, so a
# miss can never fall through to tmux's current window.
target() {
  local id
  id=$(t list-windows -t "=$session" -F '#{window_id} #{window_name}' 2>/dev/null |
    awk -v n="$1" 'substr($0, index($0, " ") + 1) == n { print $1; exit }')
  echo "${id:-=$session:=claude-rc-no-such-window}"
}
pane() { t display -p -t "$(target "$1")" "$2"; }
start_dir() { pane "$1" '#{?pane_start_path,#{pane_start_path},#{pane_current_path}}'; }

# --- the list --------------------------------------------------------------------------

# Lines of the list as "name id dir", skipping comments, blanks and anything malformed
# (a name other than letters, digits, _ -; an id other than a UUID or "server"; no dir)
entry_re="^[A-Za-z0-9_-]+ (server|$uuid_re) /"
entries() { [ -f "$list" ] && grep -E "$entry_re" "$list"; }
check_list() {
  [ -f "$list" ] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$list" | grep -vE "$entry_re" | while IFS= read -r l; do
    echo "claude-rc: ignoring a malformed line in $list: $l" >&2
  done
}
entry() { entries | awk -v n="$1" '$1 == n' | head -n 1; }
list_id() { entry "$1" | awk '{print $2}'; }
list_dir() { entry "$1" | sed 's/^[^ ]* [^ ]* //'; }
is_server_entry() { [ "$(list_id "$1")" = server ]; }

# --- processes ---------------------------------------------------------------------------

# Command lines of every process in these panes (the pane processes and all descendants)
tree() {
  [ $# -gt 0 ] || return 0
  ps -A -o pid= -o ppid= -o args= | awk -v roots="$*" '
    BEGIN { n = split(roots, r, " "); for (i = 1; i <= n; i++) keep[r[i]] = 1 }
    { pid[NR] = $1; ppid[NR] = $2; line[NR] = $0 }
    END {
      do {
        changed = 0
        for (i = 1; i <= NR; i++)
          if (!(pid[i] in keep) && (ppid[i] in keep)) { keep[pid[i]] = 1; changed = 1 }
      } while (changed)
      for (i = 1; i <= NR; i++)
        if (pid[i] in keep) { l = line[i]; sub(/^ *[0-9]+ +[0-9]+ +/, "", l); print l }
    }'
}
# claude processes among those, as "claude <first argument>" only (never the rest of the
# line). claude may run under an interpreter (node .../claude), but not `sh -c "claude"`.
claude_cmds() {
  awk '{ for (i = 1; i <= 2 && i <= NF; i++) if ($i ~ /(^|\/)claude$/) { print "claude " $(i + 1); break } }'
}
claude_in() { tree "$(pane "$1" '#{pane_pid}')" | claude_cmds; }
is_server() { has_window "$1" && claude_in "$1" | grep -qx 'claude remote-control'; }

# --- conversations -------------------------------------------------------------------------

# The conversation each window's claude is on right now, as "window<TAB>session-id",
# from claude's own scripting interface. A claude belongs to a window when it is the
# pane's process or its child (the pane runs `sh -c "claude ...; exec $SHELL"`).
live_ids() {
  has_session && have claude && have python3 || return 0
  claude agents --json 2>/dev/null | PANES=$(t list-panes -s -t "=$session" -F '#{pane_pid} #{window_name}') python3 -c '
import json, os, subprocess, sys
panes = dict(l.split(" ", 1) for l in os.environ["PANES"].splitlines() if " " in l)
try:
    agents = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
for a in agents if isinstance(agents, list) else []:
    pid, sid = str(a.get("pid", "")), a.get("sessionId")
    if not pid or not sid:
        continue
    ppid = subprocess.run(["ps", "-o", "ppid=", "-p", pid], stdout=subprocess.PIPE,
                          universal_newlines=True).stdout.strip()
    window = panes.get(pid) or panes.get(ppid)
    if window:
        print(window + "\t" + sid)
'
}
live=
live_loaded=
load_live() { [ -n "$live_loaded" ] || { live=$(live_ids); live_loaded=1; }; }
live_id() { load_live; printf '%s\n' "$live" | awk -F '\t' -v n="$1" '$1 == n {print $2; exit}'; }

# The id a window was started with, from its command line
start_id() {
  pane "$1" '#{pane_start_command}' |
    sed -nE 's/.*--(resume|session-id)[ =]([0-9a-fA-F-]{36}).*/\2/p'
}

# Best known id for a window: "server", or its conversation: live, the list, its start command
id_for() {
  local id
  is_server_entry "$1" && { echo server; return; }
  id=$(live_id "$1"); [ -n "$id" ] || id=$(list_id "$1"); [ -n "$id" ] || id=$(start_id "$1")
  [ -z "$id" ] && is_server "$1" && id=server
  echo "$id"
}

# Point a conversation's list entry at a new id
set_id() {
  [ -n "$2" ] && [ -n "$(entry "$1")" ] && [ "$(list_id "$1")" != "$2" ] || return 0
  is_server_entry "$1" && return 0
  valid_uuid "$2" || return 0
  awk -v n="$1" -v id="$2" '!/^[[:space:]]*#/ && $1 == n { $2 = id } { print }' "$list" >"$list.$$" &&
    mv "$list.$$" "$list"
}
# Refresh the list's conversation ids from the windows running now
sync_list() {
  [ -f "$list" ] || return 0
  load_live
  local name id
  while IFS=$'\t' read -r name id; do
    [ -n "$name" ] && set_id "$name" "$id"
  done <<EOF
$live
EOF
}

new_id() {
  if have uuidgen; then uuidgen
  elif [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  else python3 -c 'import uuid; print(uuid.uuid4())'
  fi | tr 'A-Z' 'a-z'
}

# What a window runs. A shell stays open after claude exits, so the window (and any
# error message) survives. "new" creates a conversation with that id, "server" runs a
# server, anything else is a conversation to resume. Everything put into a command line
# is checked here, whatever the list file says.
cmd_for() {
  case $1 in
    new) valid_uuid "$2" || die "bad session id '$2'"
         echo "claude --session-id $2 $flags; exec \${SHELL:-bash}" ;;
    server) echo "claude remote-control $server_flags; exec \${SHELL:-bash}" ;;
    *) valid_uuid "$1" || die "bad session id '$1' in $list"
       echo "claude --resume $1 $flags; exec \${SHELL:-bash}" ;;
  esac
}

logged_in() { claude auth status 2>/dev/null | grep -q '"loggedIn": *true'; }
need_login() {
  have claude || die "claude isn't installed"
  if [ -z "$1" ] && logged_in; then return; fi
  # in the background there's no one to log in: wait for `claude-rc restart --login`
  [ -n "$watching" ] && die "not logged in to Claude: run claude-rc restart --login"
  [ -n "$1" ] || echo "Not logged in to Claude."
  echo "Running 'claude auth login'..."
  claude auth login || die "login failed"
}

# Conversations: connected / disconnected / exited / missing. Servers: running / exited / missing.
status() {
  has_window "$1" || { echo missing; return; }
  if is_server_entry "$1"; then
    if is_server "$1"; then echo running; else echo exited; fi
    return
  fi
  if [ "$(pane "$1" '#{pane_dead}')" = 1 ] || [ -z "$(claude_in "$1")" ]; then
    echo exited
  elif t capture-pane -p -t "$(target "$1")" | grep -q 'Remote Control disconnected'; then
    echo disconnected
  else
    echo connected
  fi
}

# Text typed into a window's prompt but not sent yet
pending() {
  t capture-pane -p -t "$(target "$1")" | grep '^❯' | tail -n 1 | sed 's/^❯ *//; s/ *$//'
}
# A first-run question (trust this folder, spawn mode) waiting in a window
asking() { t capture-pane -p -t "$(target "$1")" | grep -qE '\[y/N\]|Choose \['; }

start() { # name cmd dir
  if has_session; then
    t new-window -d -t "=$session:" -n "$1" -c "$3" "$2"
  elif [ -n "$INVOCATION_ID" ] && have systemd-run && ! t list-sessions >/dev/null 2>&1; then
    # Under systemd, a tmux server started here would be in the service's cgroup and
    # killed when the run ends: start it in a scope of its own
    systemd-run --user --scope --quiet --collect --unit "claude-rc-tmux-$$" \
      tmux $CLAUDE_RC_TMUX new-session -d -s "$session" -n "$1" -c "$3" "$2"
  else
    t new-session -d -s "$session" -n "$1" -c "$3" "$2"
  fi
}

# Wait until a window's claude reports the expected conversation
confirm() { # name id
  local i=0
  while [ $i -lt "${CLAUDE_RC_WAIT:-30}" ]; do
    sleep 1
    [ "$(live_ids | awk -F '\t' -v n="$1" '$1 == n {print $2; exit}')" = "$2" ] && return 0
    [ "$(status "$1")" = exited ] && return 1
    i=$((i + 1))
  done
  return 1
}

# Check a server came up
confirm_server() { # name
  sleep "${CLAUDE_RC_SERVER_WAIT:-5}"
  if asking "$1"; then
    echo "$1 is waiting for an answer (first run in this folder): tmux attach -t $session, pick '$1'"
  elif is_server "$1"; then
    echo "$1: server running"
  else
    echo "$1 didn't stay up: tmux attach -t $session, pick '$1'"
    return 1
  fi
}

restart() { # name; prints a line, fails if it didn't come back
  local id dir p
  id=$(id_for "$1")
  dir=$(list_dir "$1"); [ -d "$dir" ] || dir=$(start_dir "$1")
  if [ "$id" = server ]; then
    if has_window "$1"; then t respawn-pane -k -t "$(target "$1")" -c "$dir" "$(cmd_for server)"
    else start "$1" "$(cmd_for server)" "$dir"
    fi
    confirm_server "$1"
    return
  fi
  p=$(pending "$1")
  [ -n "$p" ] && echo "  note: $1 had unsent input: $p"
  if [ -z "$id" ]; then # no known conversation: rerun whatever it was started with
    t respawn-pane -k -t "$(target "$1")"
    echo "restarted $1 (no session id known, not checked)"
    return
  fi
  set_id "$1" "$id"
  t respawn-pane -k -t "$(target "$1")" -c "$dir" "$(cmd_for "$id")"
  if confirm "$1" "$id"; then
    echo "restarted $1, resumed $id"
  else
    echo "restarted $1 but it didn't come back on $id: tmux attach -t $session, then pick '$1'"
    return 1
  fi
}

# claude running in tmux sessions other than ours, which nothing here manages:
# "target<TAB>dir<TAB>claude <first arg>"
others() {
  local s w pid dir c
  t list-panes -a -F "#{session_name}	#{window_index}	#{pane_pid}	#{pane_current_path}" 2>/dev/null |
    while IFS=$'\t' read -r s w pid dir; do
      [ "$s" = "$session" ] && continue
      tree "$pid" | claude_cmds | sort -u | while IFS= read -r c; do
        # sessions a server spawned are its business, show the server only
        case $c in "claude --print") continue ;; esac
        printf '%s\t%s\t%s\n' "$s:$w" "$dir" "$c"
      done
    done
}

# --- commands -----------------------------------------------------------------------------

# Everything, one row per line: kind name status id dir
rows() {
  local n id dir
  sync_list
  for n in $( { entries | awk '{print $1}'; windows; } | awk '!seen[$0]++'); do
    if is_server_entry "$n" || { has_window "$n" && [ "$(id_for "$n")" = server ]; }; then
      dir=$(list_dir "$n"); [ -n "$dir" ] || dir=$(start_dir "$n")
      printf 'server\t%s\t%s\t\t%s\n' "$n" "$(status "$n")" "$dir"
      continue
    fi
    if has_window "$n"; then id=$(id_for "$n"); dir=$(start_dir "$n")
    else id=$(list_id "$n"); dir=$(list_dir "$n")
    fi
    [ -n "$(entry "$n")" ] && dir=$(list_dir "$n")
    printf 'conversation\t%s\t%s\t%s\t%s\n' "$n" "$(status "$n")" "$id" "$dir"
  done
  others | while IFS=$'\t' read -r n dir c; do
    printf 'unmanaged\t%s\trunning\t%s\t%s\n' "$n" "$c" "$dir"
  done
}

cmd_ls() {
  local json= r
  [ "$1" = --json ] && json=1
  if ! has_session && [ ! -f "$list" ] && [ -z "$json" ]; then
    echo "No '$session' tmux session and no list yet. See claude-rc --help."
  fi
  r=$(rows)
  if [ -n "$json" ]; then
    have python3 || die "--json needs python3"
    printf '%s\n' "$r" | python3 -c '
import json, sys
keys = ["kind", "name", "status", "id", "dir"]
out = []
for line in sys.stdin.read().splitlines():
    if not line:
        continue
    row = dict(zip(keys, line.split("\t")))
    if row.get("kind") == "unmanaged":
        row["command"], row["id"] = row["id"], ""
    out.append({k: v for k, v in row.items() if v != ""})
print(json.dumps(out, indent=2))'
    return
  fi
  printf '%s\n' "$r" | awk -F '\t' -v home="$HOME" '
    function short(d) { if (index(d, home) == 1) d = "~" substr(d, length(home) + 1); return d }
    $1 == "server" { printf "%-20s %-13s server in %s\n", $2, $3, short($5) }
    $1 == "conversation" { printf "%-20s %-13s %s\n", $2, $3, ($4 == "" ? "-" : $4) }
    $1 == "unmanaged" { other = other sprintf("  %-18s %s in %s\n", $2, $4, short($5)) }
    END {
      if (other != "") {
        print ""
        print "Also running in other tmux sessions (not managed; to manage a server, stop it"
        print "and run claude-rc add NAME DIR --server):"
        printf "%s", other
      }
    }'
  if [ -n "$(entries)" ] && ! installed; then
    echo
    echo "Not brought back after a crash or reboot: claude-rc install"
  fi
}

cmd_up() {
  [ -f "$list" ] || die "no list at $list yet: run 'claude-rc save' or 'claude-rc add'"
  need_login
  local name id dir
  while read -r name id dir; do
    [ -n "$name" ] || continue
    has_window "$name" && continue
    if [ ! -d "$dir" ]; then echo "skip $name: no folder $dir" >&2; continue; fi
    if [ "$id" = server ]; then start "$name" "$(cmd_for server)" "$dir"
    else start "$name" "$(cmd_for "$id")" "$dir"
    fi
    echo "started $name"
  done <<EOF
$(entries)
EOF
}

# Failed background restarts in a row, per name
fails_dir=$(dirname "$list")/failing
fails() { cat "$fails_dir/$1" 2>/dev/null || echo 0; }
set_fails() {
  if [ "$2" = 0 ]; then rm -f "$fails_dir/$1"; else mkdir -p "$fails_dir" && echo "$2" >"$fails_dir/$1"; fi
}

cmd_restart() {
  local login= names= n s first=1 failed=
  for n in "$@"; do
    case $n in
      -l|--login) login=1 ;;
      -*) die "unknown option $n" ;;
      *) { [ -n "$(entry "$n")" ] || has_window "$n"; } || die "nothing called '$n'"
         names="$names $n" ;;
    esac
  done
  if [ -z "$names" ]; then
    for n in $( { entries | awk '{print $1}'; windows; } | awk '!seen[$0]++'); do
      s=$(status "$n")
      case $s in
        exited) names="$names $n" ;;
        missing) is_server_entry "$n" && names="$names $n" ;;
        disconnected) [ -n "$watching" ] ||
          echo "$n: disconnected but still running, left alone (run /remote-control in it)" ;;
      esac
    done
  fi
  if [ -z "$names" ]; then
    [ -n "$watching" ] || echo "Everything is running, nothing to restart."
    return
  fi
  need_login "$login"
  load_live # read every window's conversation before any of them restarts
  for n in $names; do
    if [ -n "$watching" ]; then
      # in the background: one that can't come back mustn't hold up the rest, and after
      # 3 failures in a row it's left alone until you restart it yourself
      [ "$(fails "$n")" -ge 3 ] && continue
      if restart "$n"; then set_fails "$n" 0
      else
        set_fails "$n" $(($(fails "$n") + 1))
        [ "$(fails "$n")" -ge 3 ] &&
          echo "$n: gave up after 3 failed restarts in a row (claude-rc restart $n to try again)"
      fi
      continue
    fi
    set_fails "$n" 0
    if ! restart "$n"; then
      failed="$failed $n"
      if [ -n "$first" ]; then
        echo "Stopped: the first restart didn't work, so the rest were left as they are." >&2
        return 1
      fi
    fi
    first=
  done
  [ -z "$failed" ] || { echo "Didn't come back cleanly:$failed" >&2; return 1; }
}

cmd_add() {
  local usage="usage: claude-rc add NAME [DIR] [--resume ID | --server]"
  local name= dir= id= mode=new cmd
  while [ $# -gt 0 ]; do
    case $1 in
      --resume) [ $# -ge 2 ] || die "$usage"; id=$2 mode=resume; shift 2 ;;
      --server) mode=server; shift ;;
      -*) die "$usage" ;;
      *) if [ -z "$name" ]; then name=$1; elif [ -z "$dir" ]; then dir=$1; else die "$usage"; fi
         shift ;;
    esac
  done
  [ -n "$name" ] || die "$usage"
  valid_name "$name" || die "use only letters, digits, _ and - in names"
  [ $mode = resume ] && ! valid_uuid "$id" && die "--resume takes a conversation id (a UUID)"
  [ -n "$(entry "$name")" ] && die "'$name' is already in the list"
  has_window "$name" && die "there's already a window called '$name'"
  dir=$(cd "${dir:-$PWD}" 2>/dev/null && pwd) || die "no folder $dir"
  case $dir in *[[:space:]]*) die "folders with spaces aren't supported: $dir" ;; esac
  need_login
  case $mode in
    new) id=$(new_id); cmd=$(cmd_for new "$id") ;;
    server) id=server; cmd=$(cmd_for server) ;;
    resume) cmd=$(cmd_for "$id") ;;
  esac
  mkdir -p "$(dirname "$list")"
  echo "$name $id $dir" >>"$list"
  start "$name" "$cmd" "$dir"
  case $mode in
    new) echo "started $name in $dir (attach: tmux attach -t $session)" ;;
    server) confirm_server "$name" ;;
    resume)
      if confirm "$name" "$id"; then echo "started $name in $dir, resumed $id"
      else
        echo "started $name but it didn't come up on $id: tmux attach -t $session, then pick '$name'"
        return 1
      fi ;;
  esac
}

cmd_rm() {
  [ -n "$1" ] || die "usage: claude-rc rm NAME"
  [ -n "$(entry "$1")" ] || has_window "$1" || die "no '$1' in the list or tmux"
  local id
  id=$(id_for "$1")
  if [ -f "$list" ]; then
    awk -v n="$1" '/^[[:space:]]*#/ || $1 != n' "$list" >"$list.$$" && mv "$list.$$" "$list"
  fi
  has_window "$1" && t kill-window -t "$(target "$1")"
  set_fails "$1" 0
  if [ "$id" = server ]; then echo "removed server $1"
  else echo "removed $1${id:+ (conversation $id)}"
  fi
}

cmd_save() {
  has_session || die "no '$session' tmux session"
  local name id dir out= skipped=
  for name in $(windows); do
    id=$(id_for "$name"); dir=$(start_dir "$name")
    if [ -z "$id" ] || ! valid_name "$name" || [ "${dir#/}" = "$dir" ]; then
      skipped="$skipped $name"; continue
    fi
    out="$out$name $id $dir"$'\n'
  done
  [ -n "$out" ] || die "couldn't find a conversation id for any window"
  mkdir -p "$(dirname "$list")"
  [ -f "$list" ] && cp "$list" "$list.bak"
  { echo "# NAME SESSION-ID|server DIR (claude-rc --help)"; printf '%s' "$out"; } >"$list"
  echo "Saved $(printf '%s' "$out" | grep -c .) windows to $list"
  [ -z "$skipped" ] || echo "Skipped (no id found, or a name with other than letters, digits, _ -):$skipped"
}

# --- in the background ----------------------------------------------------------------------

unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
agent_label=dotfiles.claude-rc
agent=$HOME/Library/LaunchAgents/$agent_label.plist
mac_log=$HOME/Library/Logs/claude-rc.log
lock=${TMPDIR:-/tmp}/claude-rc-$(id -u)-$session.lock

installed() {
  if [ "$(uname)" = Darwin ]; then [ -f "$agent" ]; else [ -f "$unit_dir/claude-rc.timer" ]; fi
}

# One background run: start what's missing, restart what exited. Never asks anything, and
# runs one at a time (a run can take a while: each restart waits for claude to come back).
cmd_watch() {
  watching=1
  [ -f "$list" ] || return 0
  # a lock left by a run that was killed is stale after 10 minutes
  [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
  mkdir "$lock" 2>/dev/null || return 0
  trap 'rmdir "$lock" 2>/dev/null' EXIT
  have claude || die "claude isn't on PATH ($PATH): run claude-rc install again from a shell where it is"
  logged_in || die "not logged in to Claude: run claude-rc restart --login"
  cmd_up
  cmd_restart
}

# Where this script lives, for the unit to run (the ~/.local/bin link if that's us)
self() {
  if [ "$HOME/.local/bin/claude-rc" -ef "$0" ]; then echo "$HOME/.local/bin/claude-rc"
  else echo "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  fi
}

# Settings the background runs need from this shell, as NAME=value lines: PATH (to find
# claude, tmux and python3), the shell and locale for the windows, and claude-rc's own
env_lines() {
  local v real
  # A claude on PATH can be a wrapper that only works in an activated shell (Omarchy's runs
  # `mise x claude -- claude`, which loops forever under systemd): put the real one first
  real=$(have mise && mise which claude 2>/dev/null)
  if [ -x "$real" ]; then echo "PATH=$(dirname "$real"):$PATH"
  else echo "PATH=$PATH"
  fi
  for v in SHELL LANG LC_ALL XDG_CONFIG_HOME CLAUDE_RC_SESSION CLAUDE_RC_FLAGS \
    CLAUDE_RC_SERVER_FLAGS CLAUDE_RC_TMUX; do
    [ -n "${!v}" ] && printf '%s=%s\n' "$v" "${!v}"
  done
}

write_if_changed() { # file; content on stdin. Fails if the file was already up to date.
  local tmp="$1.$$"
  cat >"$tmp"
  if cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
  mv "$tmp" "$1"
}

install_systemd() {
  have systemctl && systemctl --user show-environment >/dev/null 2>&1 ||
    die "no systemd user session here: run 'claude-rc watch' from cron every minute instead"
  mkdir -p "$unit_dir"
  local exe changed=
  exe=$(self)
  {
    echo "# Written by claude-rc install. Logs: claude-rc log"
    echo "[Unit]"
    echo "Description=Keep Claude Remote Control running (claude-rc watch)"
    echo
    echo "[Service]"
    echo "Type=oneshot"
    echo "TimeoutStartSec=10min"
    echo "ExecStart=\"$exe\" watch"
    # systemd expands % and needs quotes and backslashes escaped
    env_lines | sed 's/\\/\\\\/g; s/"/\\"/g; s/%/%%/g; s/.*/Environment="&"/'
  } | write_if_changed "$unit_dir/claude-rc.service" && changed=1
  cat <<'EOF' | write_if_changed "$unit_dir/claude-rc.timer" && changed=1
# Written by claude-rc install
[Unit]
Description=Check Claude Remote Control every minute, from boot

[Timer]
OnBootSec=15s
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable -q --now claude-rc.timer || die "couldn't enable claude-rc.timer"
  [ -n "$changed" ] && systemctl --user start --no-block claude-rc.service
  echo "systemd: claude-rc.timer checks every minute, starting at boot"

  # Without lingering, user services only run while you're logged in
  if [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" != yes ]; then
    if loginctl enable-linger 2>/dev/null; then
      echo "lingering on: it starts at boot, before anyone logs in"
    else
      echo "To start at boot before anyone logs in, run: sudo loginctl enable-linger $(id -un)"
    fi
  fi
}

install_launchd() {
  local exe xml='s/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
  exe=$(self)
  mkdir -p "$(dirname "$agent")" "$(dirname "$mac_log")"
  {
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$agent_label</string>
  <key>ProgramArguments</key>
  <array><string>$(printf '%s' "$exe" | sed "$xml")</string><string>watch</string></array>
  <key>EnvironmentVariables</key>
  <dict>
EOF
    env_lines | sed "$xml" | sed 's#^\([^=]*\)=\(.*\)$#    <key>\1</key><string>\2</string>#'
    cat <<EOF
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>$mac_log</string>
  <key>StandardErrorPath</key><string>$mac_log</string>
</dict>
</plist>
EOF
  } | write_if_changed "$agent"
  launchctl bootout "gui/$(id -u)/$agent_label" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$agent" || die "couldn't load $agent"
  echo "launchd: checks every minute while you're logged in (macOS runs agents after login)"
}

cmd_install() {
  have claude || die "claude isn't on PATH: install Claude Code first"
  if [ "$(uname)" = Darwin ]; then install_launchd; else install_systemd; fi
  echo "Settings come from this shell (PATH, SHELL, CLAUDE_RC_*): after changing them, run it again."
  # Nothing to keep running yet: offer to serve a folder
  if [ -z "$(entries)" ] && [ -t 0 ] && [ -t 1 ]; then
    local dir name
    echo
    printf 'Folder to serve with Remote Control (enter: %s, n: none for now): ' "$PWD"
    read -r dir || return 0
    case $dir in n|N) echo "Later: claude-rc add NAME DIR --server"; return 0 ;; esac
    dir=${dir:-$PWD}
    case $dir in "~"|"~/"*) dir=$HOME${dir#\~} ;; esac
    name=$(basename "$dir" | tr -c 'A-Za-z0-9\n_-' '-')
    cmd_add "$name" "$dir" --server
  elif [ -z "$(entries)" ]; then
    echo "Nothing in the list yet: claude-rc add NAME DIR --server"
  fi
}

cmd_uninstall() {
  if [ "$(uname)" = Darwin ]; then
    launchctl bootout "gui/$(id -u)/$agent_label" 2>/dev/null
    rm -f "$agent"
  else
    systemctl --user disable -q --now claude-rc.timer 2>/dev/null
    rm -f "$unit_dir/claude-rc.service" "$unit_dir/claude-rc.timer"
    systemctl --user daemon-reload 2>/dev/null
  fi
  echo "Not kept running anymore. What's running now keeps running; the list is kept."
}

cmd_log() {
  if [ "$(uname)" = Darwin ]; then
    [ -f "$mac_log" ] || { echo "no log yet ($mac_log)"; return; }
    tail -n 50 "$@" "$mac_log"
  else
    journalctl --user -u claude-rc.service -n 50 --no-pager "$@"
  fi
}

case ${1:-ls} in ls|up|restart|add|rm|save|watch) check_list ;; esac
case ${1:-ls} in
  ls) shift; cmd_ls "$@" ;;
  up) cmd_up ;;
  restart) shift; cmd_restart "$@" ;;
  add) shift; cmd_add "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  save) cmd_save ;;
  watch) cmd_watch ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  log) shift; cmd_log "$@" ;;
  -h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  *) die "unknown command '$1' (see claude-rc --help)" ;;
esac
