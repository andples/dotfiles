#!/usr/bin/env bash
# Show tinymist's live Typst preview beside the editor: it updates as you type, and
# clicking in it moves the cursor in Zed. Zed's Typst extension serves it (the
# background preview in zed/typst.json) once a .typ file is open.
#
#   typview          open the preview (again: bring it back without moving windows)
#
# macOS: LocalView, a borderless viewer built from ~/.local/share/localview/LocalView.swift
# on first use, on the right half of Zed's window with Zed on the left half. It hides
# while Zed shows a non-Typst file and quits after a minute of that, or when Zed quits.
# Moving Zed's window needs Zed, and following it needs LocalView, in System Settings >
# Privacy > Accessibility.
# Linux: a Chromium app window if there is one (no browser controls), else the default
# browser; Omarchy's tiling puts it beside Zed.
set -u
url=${TYPVIEW_URL:-http://127.0.0.1:23635}
have() { command -v "$1" >/dev/null 2>&1; }

if ! curl -s -o /dev/null --max-time 2 "$url"; then
  echo "typview: no preview at $url: open a .typ file in Zed first" >&2
  echo "  (it needs the background preview from zed/typst.json: ./install.sh zed)" >&2
  exit 1
fi

if [ "$(uname)" != Darwin ]; then
  for b in chromium chromium-browser google-chrome brave; do
    if have "$b"; then
      nohup "$b" --app="$url" >/dev/null 2>&1 &
      exit 0
    fi
  done
  nohup xdg-open "$url" >/dev/null 2>&1 &
  exit 0
fi

# Build LocalView.app when it's missing or its source changed
src=${XDG_DATA_HOME:-$HOME/.local/share}/localview/LocalView.swift
app=${XDG_CACHE_HOME:-$HOME/.cache}/localview/LocalView.app
bin=$app/Contents/MacOS/LocalView
if [ ! -x "$bin" ] || [ "$src" -nt "$bin" ]; then
  have swiftc || { echo "typview: building the viewer needs Swift (xcode-select --install)" >&2; exit 1; }
  echo "typview: building LocalView"
  mkdir -p "$app/Contents/MacOS"
  cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>LocalView</string>
  <key>CFBundleIdentifier</key><string>dotfiles.localview</string>
  <key>CFBundleExecutable</key><string>LocalView</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
PLIST
  pkill -f "$bin" 2>/dev/null
  swiftc -O -o "$bin" "$src" || { echo "typview: building LocalView failed" >&2; exit 1; }
fi

# Already open: bring it back, keeping however the windows were arranged
if pgrep -qf "$bin"; then
  open -a "$app"
  osascript -e 'tell application "Zed" to activate' >/dev/null 2>&1
  exit 0
fi

# Split Zed's front window: Zed keeps the left half, the preview gets the right
frame=$(osascript -e 'tell application "System Events" to tell process "Zed"
  set {x, y} to position of front window
  set {w, h} to size of front window
  set size of front window to {w div 2, h}
  return (x as text) & " " & y & " " & w & " " & h
end tell' 2>/dev/null)
if [ -n "$frame" ]; then
  set -- $frame
  half=$(($3 / 2))
  open -a "$app" --args "$url" $(($1 + half)) "$2" $(($3 - half)) "$4"
else
  echo "typview: give Zed Accessibility access (System Settings > Privacy) to place the windows side by side" >&2
  open -a "$app" --args "$url"
fi
sleep 0.3
osascript -e 'tell application "Zed" to activate' >/dev/null 2>&1
exit 0
