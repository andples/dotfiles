# Shared git behaviour settings. install.sh includes this from ~/.config/git/config,
# so each machine keeps its own identity, credential helpers and aliases there.
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
[rerere]
	enabled = true
[help]
	autocorrect = prompt
