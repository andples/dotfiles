# Commits, pulls and pushes ~/notes (notes-sync from the notes package).
# install.sh enables notes-sync.timer. Logs: journalctl --user -u notes-sync
[Unit]
Description=Sync ~/notes with its git remote

[Service]
Type=oneshot
ExecStart=%h/.local/bin/notes-sync -q
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Nice=10
