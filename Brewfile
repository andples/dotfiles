# Everything this Mac has from Homebrew. On a new Mac: `brew bundle --file ~/dotfiles/Brewfile`
# (it skips what's already installed). `brew bundle check --file ~/dotfiles/Brewfile` lists
# what's missing. Delete any line you don't want before running it.
# Apps that came from elsewhere (App Store, direct downloads) are listed as casks where
# Homebrew has one, so they're installed the same way next time.

