// Python: ty for types, ruff for lint + format (imports sorted on save).
// Other Python servers are switched off so diagnostics don't show up twice.
// Neither needs installing: Zed downloads both.
{
  "languages": {
    "Python": {
      // no inline ": Unknown" type labels; ty still flags real errors (typos, bad calls)
      "inlay_hints": { "enabled": false },
      "language_servers": ["ty", "ruff", "!basedpyright", "!pyright", "!pylsp", "!pyrefly", "..."],
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "language_server": { "name": "ruff" } }
      ]
    }
  },
  "lsp": {
    "ruff": {
      // lines up to 100 before ruff wraps them (its default, 88, splits many ordinary `if`
      // conditions into a parenthesised block). A project's own ruff/pyproject settings win.
      "initialization_options": {
        "settings": { "lineLength": 100, "configurationPreference": "filesystemFirst" }
      }
    },
    "ty": {
      // completions only offer names already in scope: accepting one never adds an import
      "settings": { "completions": { "autoImport": false } }
    }
  }
}
