// General editor behaviour: vim, inlay hints, format on save, no AI/telemetry.
{
  "vim_mode": true,
  // "wrapped": relative numbers count wrapped lines, matching j/k in wrapped files
  "relative_line_numbers": "wrapped",
  "vertical_scroll_margin": 5,
  "cursor_blink": false,
  "show_whitespaces": "selection",
  "indent_guides": { "enabled": true, "coloring": "indent_aware" },
  "inlay_hints": { "enabled": true, "show_background": false },
  // save a second after typing stops, not on switching away: a delayed autosave skips the
  // whitespace trim and formatting, so alt-tab no longer strips the indent of a fresh line
  // (:w / cmd-s still trims and formats)
  "autosave": { "after_delay": { "milliseconds": 1000 } },
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "collaboration_panel": { "button": false },
  "terminal": { "dock": "bottom" },
  "disable_ai": true,
  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_install_extensions": { "toml": true }
}
