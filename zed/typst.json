// Typst: tinymist (downloaded by the typst extension) writes the PDF next to the source
// on every save and formats with typstyle. `space p` opens the PDF, which then reloads itself.
{
  "auto_install_extensions": { "typst": true },
  "languages": {
    // prose is rewrapped to 80 columns on save (below), so lines stay vim-motion friendly;
    // `gq` rewraps by hand in between
    "Typst": {
      "tab_size": 2,
      "soft_wrap": "editor_width",
      "preferred_line_length": 80,
      "wrap_guides": [80],
      "allow_rewrap": "anywhere"
    }
  },
  "lsp": {
    "tinymist": {
      // live preview served at http://127.0.0.1:23635 (VS Code's side pane, in a browser
      // window): updates as you type, click to jump between preview and source
      "initialization_options": {
        "preview": {
          "background": {
            "enabled": true,
            // partial rendering: only pages in view are drawn (VS Code's default), which keeps
            // long documents (100+ pages) responsive
            "args": [
              "--data-plane-host=127.0.0.1:23635",
              "--invert-colors=never",
              "--partial-rendering=true"
            ]
          }
        }
      },
      "settings": {
        "exportPdf": "onSave",
        "formatterMode": "typstyle",
        "formatterPrintWidth": 80,
        "formatterProseWrap": true
      }
    }
  }
}
