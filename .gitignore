# --- Secrets & credentials ---
*.pem
*.key
*.p12
id_rsa
id_ed25519
id_ecdsa
*_rsa
*_ed25519
*.ppk
.netrc
.npmrc
.pypirc
.env
.env.*
*credentials*
*token*
*secret*
.aws/credentials
.ssh/known_hosts

# --- Shell history (contains commands, sometimes secrets typed by mistake) ---
.zsh_history
.bash_history
.zcompdump*
.zsh_sessions/

# --- Editor / IDE junk ---
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# --- Nvim-specific runtime/cache (regenerated, don't need to track) ---
nvim/.local/share/nvim/
nvim/.local/state/nvim/
nvim/.cache/nvim/
undodir/
*.undo

# --- GPG ---
*.gpg
*.asc
secring.*

# --- Machine-specific configs you don't want synced blindly ---
.zshrc.local
local.sh
secrets.sh
.gitconfig.local
